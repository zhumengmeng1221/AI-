<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>RunningHub AI Application</title>
  <style>
    :root {
      color-scheme: dark;
      --bg: #060a11;
      --panel: #0b121f;
      --panel-soft: #0d1727;
      --line: rgba(105, 130, 168, .18);
      --line-hover: rgba(105, 130, 168, .35);
      --text: #e6f0ff;
      --muted: #7d96b8;
      --aqua: #1edaf9;
      --accent: #3b8bff;
      --sidebar-w: 200px;
      --topbar-h: 52px;
      --radius: 10px;
      --gap: 16px;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background:
        radial-gradient(1400px 600px at 60% -10%, rgba(29, 86, 182, .15), transparent 60%),
        var(--bg);
      color: #dbe9ff;
      font-family: "PingFang SC", "Microsoft YaHei", "Segoe UI", sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    /* ── Top Bar ── */
    .topbar {
      height: var(--topbar-h);
      border-bottom: 1px solid var(--line);
      background: rgba(6, 10, 17, .96);
      backdrop-filter: blur(12px);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 20px;
      position: sticky;
      top: 0;
      z-index: 100;
    }
    .left-head {
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .rh-logo {
      width: 28px;
      height: 28px;
      border-radius: 8px;
      background: linear-gradient(135deg, #00d4ff, #3b6bff);
      box-shadow: 0 0 16px rgba(30, 140, 255, .4);
      flex-shrink: 0;
    }
    .search-mini {
      width: 300px;
      height: 34px;
      border-radius: 8px;
      border: 1px solid var(--line);
      background: #0d1727;
      color: #adc2e5;
      font-size: 13px;
      padding: 0 14px;
      outline: none;
      transition: border-color .2s, box-shadow .2s;
    }
    .search-mini:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px rgba(59, 139, 255, .15);
    }
    .center-head {
      color: #ff9e38;
      font-size: 13px;
      font-weight: 600;
      letter-spacing: .03em;
      padding: 5px 14px;
      border: 1px solid rgba(255, 158, 56, .25);
      border-radius: 20px;
      background: rgba(255, 158, 56, .08);
    }
    .right-head {
      display: flex;
      gap: 8px;
      align-items: center;
    }
    .head-btn {
      height: 32px;
      border-radius: 8px;
      border: 1px solid var(--line);
      background: transparent;
      color: #c9dbf6;
      font-size: 12px;
      padding: 0 16px;
      cursor: pointer;
      transition: all .2s;
    }
    .head-btn:hover {
      border-color: var(--line-hover);
      background: rgba(59, 139, 255, .08);
      color: #fff;
    }
    .head-btn.primary {
      background: linear-gradient(135deg, #3b6bff, #2a5ce6);
      border-color: transparent;
      color: #fff;
      font-weight: 500;
    }
    .head-btn.primary:hover {
      background: linear-gradient(135deg, #4d7aff, #3b6bff);
      box-shadow: 0 4px 16px rgba(59, 107, 255, .3);
    }

    /* ── Shell ── */
    .shell {
      display: grid;
      grid-template-columns: var(--sidebar-w) 1fr;
      min-height: calc(100vh - var(--topbar-h));
    }

    /* ── Sidebar ── */
    .sidebar {
      border-right: 1px solid var(--line);
      background: #080e18;
      padding: 16px 12px;
      position: sticky;
      top: var(--topbar-h);
      height: calc(100vh - var(--topbar-h));
      overflow-y: auto;
    }
    .sidebar-logo {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 20px;
      padding: 0 8px;
    }
    .sidebar-logo .dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: var(--aqua);
      box-shadow: 0 0 8px rgba(30, 218, 249, .5);
    }
    .sidebar-logo span {
      font-size: 15px;
      font-weight: 700;
      color: #e6f0ff;
      letter-spacing: .02em;
    }
    .nav-group {
      margin-bottom: 16px;
    }
    .nav-label {
      font-size: 10px;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: .08em;
      padding: 0 8px;
      margin-bottom: 6px;
    }
    .nav-item {
      width: 100%;
      border: 1px solid transparent;
      background: transparent;
      color: #8fa4c8;
      font-size: 13px;
      text-align: left;
      border-radius: 8px;
      padding: 9px 12px;
      cursor: pointer;
      transition: all .15s;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .nav-item:hover {
      color: #c9dbf6;
      background: rgba(59, 139, 255, .06);
    }
    .nav-item.active {
      color: #fff;
      border-color: rgba(59, 139, 255, .4);
      background: linear-gradient(135deg, rgba(59, 107, 255, .15), rgba(20, 40, 80, .6));
    }
    .nav-icon {
      width: 18px;
      height: 18px;
      border-radius: 4px;
      background: rgba(105, 130, 168, .15);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 11px;
      flex-shrink: 0;
    }
    .nav-item.active .nav-icon {
      background: rgba(59, 139, 255, .3);
    }

    /* ── Content ── */
    .content {
      padding: 20px 24px 32px;
      max-width: 1400px;
    }
    .page-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 20px;
    }
    .page-title {
      font-size: 18px;
      font-weight: 600;
      color: #e6f0ff;
    }
    .page-title em {
      font-style: normal;
      color: var(--aqua);
    }
    .page-actions {
      display: flex;
      gap: 8px;
    }
    .action-btn {
      height: 32px;
      border-radius: 8px;
      border: 1px solid var(--line);
      background: transparent;
      color: #a8bee0;
      font-size: 12px;
      padding: 0 14px;
      cursor: pointer;
      transition: all .2s;
    }
    .action-btn:hover {
      border-color: var(--line-hover);
      color: #fff;
      background: rgba(59, 139, 255, .08);
    }

    /* ── Section ── */
    .section {
      margin-bottom: 28px;
    }
    .section-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 14px;
    }
    .section-head h3 {
      font-size: 15px;
      color: #dce9ff;
      font-weight: 600;
    }
    .section-more {
      font-size: 12px;
      color: var(--muted);
      cursor: pointer;
      transition: color .2s;
    }
    .section-more:hover {
      color: var(--accent);
    }

    /* ── Recommended Apps Grid ── */
    .reco-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--gap);
    }
    .reco-item {
      border: 1px solid var(--line);
      border-radius: var(--radius);
      min-height: 72px;
      background: linear-gradient(145deg, #0f1a2c, #0a1220);
      padding: 14px;
      display: flex;
      align-items: center;
      gap: 14px;
      cursor: pointer;
      transition: all .2s;
    }
    .reco-item:hover {
      border-color: var(--line-hover);
      background: linear-gradient(145deg, #142238, #0e1628);
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(0, 0, 0, .3);
    }
    .reco-info { flex: 1; min-width: 0; }
    .reco-name {
      font-size: 13px;
      color: #e6f0ff;
      font-weight: 500;
      line-height: 1.4;
      margin-bottom: 4px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .reco-sub {
      font-size: 11px;
      color: var(--muted);
    }
    .reco-thumb {
      width: 48px;
      height: 48px;
      border-radius: 10px;
      background: linear-gradient(135deg, #1a3a6a, #0e2040);
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
    }
    .reco-item:nth-child(1) .reco-thumb { background: linear-gradient(135deg, #1e4a8a, #0d2244); }
    .reco-item:nth-child(2) .reco-thumb { background: linear-gradient(135deg, #2a3f6a, #141e38); }
    .reco-item:nth-child(3) .reco-thumb { background: linear-gradient(135deg, #3a2f6a, #1e1538); }
    .reco-item:nth-child(4) .reco-thumb { background: linear-gradient(135deg, #1a5a4a, #0d2820); }

    /* ── Featured Picks ── */
    .pick-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--gap);
    }
    .pick {
      border: 1px solid var(--line);
      border-radius: var(--radius);
      height: 140px;
      overflow: hidden;
      background: linear-gradient(145deg, #162438, #0f1a2c);
      position: relative;
      cursor: pointer;
      transition: all .2s;
    }
    .pick:nth-child(2) { background: linear-gradient(145deg, #142238, #101828); }
    .pick:nth-child(3) { background: linear-gradient(145deg, #2a2540, #181430); }
    .pick:hover {
      border-color: var(--line-hover);
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(0, 0, 0, .3);
    }
    .pick-inner {
      padding: 16px;
      height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
    }
    .pick-tag {
      font-size: 10px;
      color: var(--aqua);
      margin-bottom: 6px;
      letter-spacing: .05em;
    }
    .pick span.pick-title {
      font-size: 15px;
      color: #edf6ff;
      font-weight: 600;
      text-shadow: 0 2px 8px rgba(0, 0, 0, .5);
    }
    .pick-desc {
      font-size: 11px;
      color: var(--muted);
      margin-top: 4px;
    }

    /* ── Filters ── */
    .filters {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      margin-bottom: 14px;
    }
    .chip {
      font-size: 12px;
      color: #8fa4c8;
      border: 1px solid rgba(103, 136, 179, .25);
      border-radius: 20px;
      padding: 5px 14px;
      background: transparent;
      cursor: pointer;
      transition: all .15s;
    }
    .chip:hover {
      border-color: var(--accent);
      color: #fff;
      background: rgba(59, 139, 255, .08);
    }
    .chip.active {
      background: linear-gradient(135deg, rgba(59, 107, 255, .2), rgba(59, 107, 255, .08));
      border-color: rgba(59, 139, 255, .5);
      color: #fff;
    }

    /* ── App Cards ── */
    .cards {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--gap);
    }
    .card {
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: #0c1525;
      overflow: hidden;
      cursor: pointer;
      transition: all .2s;
    }
    .card:hover {
      border-color: var(--line-hover);
      transform: translateY(-3px);
      box-shadow: 0 8px 28px rgba(0, 0, 0, .35);
    }
    .cover {
      aspect-ratio: 4 / 3;
      position: relative;
      overflow: hidden;
    }
    .cover-bg {
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 40px;
    }
    .card:nth-child(4n+1) .cover-bg { background: linear-gradient(135deg, #2a4a8a, #152a55); }
    .card:nth-child(4n+2) .cover-bg { background: linear-gradient(135deg, #3a2f6a, #1e1538); }
    .card:nth-child(4n+3) .cover-bg { background: linear-gradient(135deg, #1a5a4a, #0d2820); }
    .card:nth-child(4n+4) .cover-bg { background: linear-gradient(135deg, #5a3a1a, #281808); }
    .ribbon {
      position: absolute;
      top: 10px;
      left: 10px;
      background: #ff4d7a;
      color: #fff;
      font-size: 10px;
      font-weight: 600;
      border-radius: 4px;
      padding: 3px 8px;
      letter-spacing: .03em;
    }
    .ribbon.hot { background: #ff8c2e; }
    .ribbon.rec { background: #3b8bff; }
    .card-body {
      padding: 12px 14px 14px;
    }
    .card-title {
      font-size: 13px;
      font-weight: 500;
      color: #e6f0ff;
      margin-bottom: 4px;
    }
    .card-meta {
      font-size: 11px;
      color: var(--muted);
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .card-meta .dot {
      width: 3px;
      height: 3px;
      border-radius: 50%;
      background: rgba(125, 150, 184, .4);
    }
    .card-stats {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-top: 8px;
      font-size: 10px;
      color: rgba(125, 150, 184, .6);
    }
    .card-stats span {
      display: flex;
      align-items: center;
      gap: 4px;
    }

    /* ── Responsive ── */
    @media (max-width: 1200px) {
      .reco-grid, .cards { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    }
    @media (max-width: 960px) {
      :root { --sidebar-w: 60px; }
      .sidebar-logo span,
      .nav-label,
      .nav-item span:not(.nav-icon) { display: none; }
      .nav-item { justify-content: center; padding: 9px; }
      .sidebar { padding: 16px 8px; }
      .reco-grid, .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .pick-grid { grid-template-columns: 1fr; }
      .center-head { display: none; }
    }
    @media (max-width: 640px) {
      .reco-grid, .cards { grid-template-columns: 1fr; }
      .search-mini { width: 160px; }
    }

    /* ── Animations ── */
    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(12px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .section { animation: fadeInUp .4s ease-out both; }
    .section:nth-child(2) { animation-delay: .08s; }
    .section:nth-child(3) { animation-delay: .16s; }
    .section:nth-child(4) { animation-delay: .24s; }
  </style>
</head>
<body>
  <header class="topbar">
    <div class="left-head">
      <span class="rh-logo"></span>
      <input class="search-mini" value="" placeholder="搜索工具、模型、关键词..." />
    </div>
    <div class="center-head">上线无限画布 ◀◀◀</div>
    <div class="right-head">
      <button class="head-btn primary">开始创作</button>
      <button class="head-btn">登录</button>
      <button class="head-btn">账户</button>
    </div>
  </header>

  <div class="shell">
    <aside class="sidebar">
      <div class="sidebar-logo">
        <span class="dot"></span>
        <span>AIHub</span>
      </div>

      <div class="nav-group">
        <div class="nav-label">导航</div>
        <button class="nav-item"><span class="nav-icon">🏠</span><span>首页</span></button>
        <button class="nav-item active"><span class="nav-icon">🤖</span><span>AI 应用</span></button>
        <button class="nav-item"><span class="nav-icon">📦</span><span>模型管理</span></button>
      </div>

      <div class="nav-group">
        <div class="nav-label">工具</div>
        <button class="nav-item"><span class="nav-icon">🔗</span><span>工作流</span></button>
        <button class="nav-item"><span class="nav-icon">⚡</span><span>API</span></button>
      </div>

      <div class="nav-group">
        <div class="nav-label">用户</div>
        <button class="nav-item"><span class="nav-icon">👤</span><span>个人中心</span></button>
      </div>
    </aside>

    <main class="content">
      <div class="page-header">
        <div class="page-title">终结生图赛道 <em>「全能图片 G2」</em></div>
        <div class="page-actions">
          <button class="action-btn">排序</button>
          <button class="action-btn">视图</button>
        </div>
      </div>

      <section class="section">
        <div class="section-head">
          <h3>推荐应用</h3>
          <span class="section-more">查看全部 →</span>
        </div>
        <div class="reco-grid">
          <article class="reco-item">
            <div class="reco-thumb">🎬</div>
            <div class="reco-info">
              <div class="reco-name">Seedance2.0 全能参考视频</div>
              <div class="reco-sub">真人实拍 · 全景参考</div>
            </div>
          </article>
          <article class="reco-item">
            <div class="reco-thumb">⚡</div>
            <div class="reco-info">
              <div class="reco-name">Seedance2.0 Fast 提速生成</div>
              <div class="reco-sub">15秒快产 · 秒级优化</div>
            </div>
          </article>
          <article class="reco-item">
            <div class="reco-thumb">🖼</div>
            <div class="reco-info">
              <div class="reco-name">Qwen Image 2512 文生图</div>
              <div class="reco-sub">从关键词到画面</div>
            </div>
          </article>
          <article class="reco-item">
            <div class="reco-thumb">✏️</div>
            <div class="reco-info">
              <div class="reco-name">Qwen Image Edit 2511</div>
              <div class="reco-sub">局部替换 / 智能融合</div>
            </div>
          </article>
          <article class="reco-item">
            <div class="reco-thumb">🧍</div>
            <div class="reco-info">
              <div class="reco-name">可爱V2.0 动作转视频</div>
              <div class="reco-sub">动作映射 · 高拟真</div>
            </div>
          </article>
          <article class="reco-item">
            <div class="reco-thumb">🔍</div>
            <div class="reco-info">
              <div class="reco-name">视频超分修复</div>
              <div class="reco-sub">超分修复 · 降噪增强</div>
            </div>
          </article>
          <article class="reco-item">
            <div class="reco-thumb">🎙</div>
            <div class="reco-info">
              <div class="reco-name">数字人音频驱动</div>
              <div class="reco-sub">歌声转动效 · 口型同步</div>
            </div>
          </article>
          <article class="reco-item">
            <div class="reco-thumb">📝</div>
            <div class="reco-info">
              <div class="reco-name">数字人文本驱动</div>
              <div class="reco-sub">文案生成 · 风格化</div>
            </div>
          </article>
        </div>
      </section>

      <section class="section">
        <div class="section-head">
          <h3>精选应用</h3>
          <span class="section-more">查看全部 →</span>
        </div>
        <div class="pick-grid">
          <div class="pick">
            <div class="pick-inner">
              <div class="pick-tag">FEATURED</div>
              <span class="pick-title">全能图片 V1</span>
              <div class="pick-desc">经典图生图 · 稳定产出</div>
            </div>
          </div>
          <div class="pick">
            <div class="pick-inner">
              <div class="pick-tag">POPULAR</div>
              <span class="pick-title">Qwen 文生图角色设定</span>
              <div class="pick-desc">角色一致性 · 风格锁定</div>
            </div>
          </div>
          <div class="pick">
            <div class="pick-inner">
              <div class="pick-tag">NEW</div>
              <span class="pick-title">人物讲解生成</span>
              <div class="pick-desc">数字人讲播 · 一键出片</div>
            </div>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="section-head">
          <h3>全部应用</h3>
          <span class="section-more">共 24 个应用</span>
        </div>
        <div class="filters">
          <span class="chip active">全部</span>
          <span class="chip">文生图</span>
          <span class="chip">图生图</span>
          <span class="chip">文生视频</span>
          <span class="chip">数字人</span>
          <span class="chip">抠图修复</span>
          <span class="chip">API</span>
          <span class="chip">4K 渲染</span>
        </div>
        <div class="cards">
          <article class="card">
            <div class="cover"><div class="cover-bg">🎨</div><span class="ribbon">新</span></div>
            <div class="card-body">
              <div class="card-title">全能图片 2.0</div>
              <div class="card-meta">三分钟出图 · 多风格</div>
              <div class="card-stats"><span>🔥 12.5k 次使用</span><span>⭐ 4.8</span></div>
            </div>
          </article>
          <article class="card">
            <div class="cover"><div class="cover-bg">🖼</div><span class="ribbon hot">热</span></div>
            <div class="card-body">
              <div class="card-title">全能图片 PRO</div>
              <div class="card-meta">图片修复 · 细节增强</div>
              <div class="card-stats"><span>🔥 8.2k 次使用</span><span>⭐ 4.9</span></div>
            </div>
          </article>
          <article class="card">
            <div class="cover"><div class="cover-bg">✨</div><span class="ribbon rec">荐</span></div>
            <div class="card-body">
              <div class="card-title">低价渠道版 G2.0 图生图</div>
              <div class="card-meta">商业海报 · 快速生成</div>
              <div class="card-stats"><span>🔥 5.1k 次使用</span><span>⭐ 4.6</span></div>
            </div>
          </article>
          <article class="card">
            <div class="cover"><div class="cover-bg">📐</div><span class="ribbon rec">荐</span></div>
            <div class="card-body">
              <div class="card-title">低价渠道版 G2.0 文生图</div>
              <div class="card-meta">高效迭代 · 批量出图</div>
              <div class="card-stats"><span>🔥 3.8k 次使用</span><span>⭐ 4.5</span></div>
            </div>
          </article>
        </div>
      </section>
    </main>
  </div>

  <script>
    window.preservedVideoFeature = {
      description: "已记住图+音频生成视频功能，后续可嵌入当前页面",
      endpoints: {
        upload: "/task/openapi/upload",
        create: "/task/openapi/create",
        outputs: "/task/openapi/outputs"
      },
      defaults: {
        workflowId: "2044669894783934465",
        imageNodeId: "133",
        imageFieldName: "image",
        audioNodeId: "125",
        audioFieldName: "audio",
        baseUrl: "https://www.runninghub.cn"
      }
    };

    // Filter chip interaction
    document.querySelectorAll('.chip').forEach(chip => {
      chip.addEventListener('click', () => {
        document.querySelectorAll('.chip').forEach(c => c.classList.remove('active'));
        chip.classList.add('active');
      });
    });

    // Sidebar nav interaction
    document.querySelectorAll('.nav-item').forEach(item => {
      item.addEventListener('click', () => {
        document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
        item.classList.add('active');
      });
    });
  </script>
</body>
</html>
